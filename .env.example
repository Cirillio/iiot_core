# Скопируй в .env (cp .env.example .env) и подставь реальные значения.
# .env в .gitignore и не коммитится.

# PostgreSQL / TimescaleDB. Пароль применяется только при первой инициализации тома pgdata.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=AdamMonitoring

# API Base URL для фронтенда iiot_admin (куда обращается браузер клиента).
# Для локального запуска: http://localhost:8080
# Для развертывания с публичным доменом: https://api.yourdomain.com
NUXT_PUBLIC_API_BASE=http://localhost:8080

# CORS Allowed Origins для IIoT.WebApi (через запятую).
# Для локального запуска: http://localhost:3000,https://localhost:3000,http://localhost:5173,https://localhost:5173
# Для развертывания с доменом админки: https://admin.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000,http://localhost:5173,https://localhost:5173

# Токен Cloudflare Tunnel (Zero Trust -> Networks -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=change-me
